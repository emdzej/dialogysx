{
  "name": "dialogysx",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based Renault/Dacia parts catalogue and repair documentation — a client-side reimplementation of Dialogys",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @dialogysx/web dev",
    "cli": "node apps/cli/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck && pnpm --filter @dialogysx/web typecheck",
    "check": "turbo run build typecheck && pnpm --filter @dialogysx/web typecheck && pnpm test",
    "format": "prettier --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.5.1",
    "turbo": "^2.8.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
